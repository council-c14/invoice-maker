<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews layout: only framework views. Text shown here is also the widget-picker preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:src="@mipmap/ic_launcher_round" />
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:text="Invoice Maker"
        android:textColor="@color/widget_ink"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/synced"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:text=""
        android:textColor="@color/widget_muted"
        android:textSize="11sp" />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="8dp"
      android:layout_weight="1"
      android:baselineAligned="false"
      android:orientation="horizontal">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.25"
        android:orientation="vertical">
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Outstanding"
          android:textColor="@color/widget_muted"
          android:textSize="11sp" />
      <TextView
          android:id="@+id/outstanding"
          android:layout_width="match_parent"
          android:layout_height="28dp"
          android:autoSizeMaxTextSize="21sp"
          android:autoSizeMinTextSize="13sp"
          android:autoSizeTextType="uniform"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:gravity="center_vertical"
          android:maxLines="1"
          android:text="MVR 0.00"
          android:textColor="@color/widget_ink"
          android:textSize="21sp" />
      <TextView
          android:id="@+id/open_count"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:singleLine="true"
          android:text="0 open invoices"
          android:textColor="@color/widget_muted"
          android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Overdue"
          android:textColor="@color/widget_muted"
          android:textSize="11sp" />
      <TextView
          android:id="@+id/overdue"
          android:ellipsize="end"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:singleLine="true"
          android:text="MVR 0.00"
          android:textColor="@color/widget_ink"
          android:textSize="13sp" />
      <TextView
          android:id="@+id/overdue_alert"
          android:ellipsize="end"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:singleLine="true"
          android:text=""
          android:textColor="@color/widget_danger"
          android:textSize="13sp"
          android:visibility="gone" />
      <TextView
          android:id="@+id/collected_label"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:singleLine="true"
          android:text="Collected"
          android:textColor="@color/widget_muted"
          android:textSize="11sp" />
      <TextView
          android:id="@+id/collected"
          android:ellipsize="end"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:singleLine="true"
          android:text="MVR 0.00"
          android:textColor="@color/widget_ink"
          android:textSize="13sp" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:orientation="horizontal">
    <TextView
        android:id="@+id/btn_invoice"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_weight="1"
        android:background="@drawable/widget_btn_primary"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="+ Invoice"
        android:textColor="@color/widget_on_primary"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/btn_quote"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_btn"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="+ Quotation"
        android:textColor="@color/widget_ink"
        android:textSize="13sp" />
  </LinearLayout>
</LinearLayout>
